# ============================================================
# .env.example — このファイルをコピーして .env を作成してください
# cp .env.example .env  (Linux/Mac)
# Copy-Item .env.example .env  (PowerShell)
#
# .env には実際のAzure認証情報を記載します。
# .env は .gitignore で除外されています。絶対にコミットしないでください。
# ============================================================

# ------------------------------------------------------------
# Azure Document Intelligence リソース情報
# Azure Portal で作成したリソースの「キーとエンドポイント」から取得
# 例: https://your-resource-name.cognitiveservices.azure.com/
# ------------------------------------------------------------
DI_BILLING_ENDPOINT=https://YOUR_RESOURCE_NAME.cognitiveservices.azure.com/

# Azure Portal の「キー1」または「キー2」（32文字の16進数文字列）
DI_API_KEY=YOUR_API_KEY_HERE

# ------------------------------------------------------------
# Read コンテナー設定（通常は変更不要）
# 利用するコンテナーイメージのタグと対応する API バージョンを
# Microsoft 公式ドキュメントで必ず確認してください。
# ------------------------------------------------------------

# コンテナーイメージ（タグは Microsoft のリリースノートに合わせて更新）
# 例: mcr.microsoft.com/azure-cognitive-services/form-recognizer/read:latest
DI_CONTAINER_IMAGE=mcr.microsoft.com/azure-cognitive-services/form-recognizer/read:latest

# FastAPI からコンテナーへのアクセス URL（Docker Compose 内部ネットワーク）
DI_CONTAINER_ENDPOINT=http://di-read:5000

# Read API のバージョン（コンテナーイメージに合わせて確認してください）
DI_API_VERSION=2024-11-30

# 使用するモデル ID（Read コンテナーでは prebuilt-read を使用）
DI_MODEL_ID=prebuilt-read

# ------------------------------------------------------------
# FastAPI アプリケーション設定（必要に応じて変更）
# ------------------------------------------------------------

# API のプレフィックス
API_PREFIX=/api/v1

# ジョブポーリング間隔（秒）
POLL_INTERVAL_SECONDS=2.0

# 同期エンドポイントの最大待機時間（秒）— PoC 専用
SYNC_TIMEOUT_SECONDS=120.0

# アップロード可能な最大ファイルサイズ（バイト、デフォルト 50MB）
MAX_UPLOAD_SIZE_BYTES=52428800

# HTTPX タイムアウト設定（秒）
HTTPX_CONNECT_TIMEOUT=10.0
HTTPX_READ_TIMEOUT=60.0
HTTPX_WRITE_TIMEOUT=30.0
HTTPX_POOL_TIMEOUT=10.0
